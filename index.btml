<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Oasis</title>

  <!-- iOS App Settings & HD Fireball Core "O" Oasis Icon -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Oasis">
  <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><defs><radialGradient id='bg' cx='50%' cy='50%' r='75%'><stop offset='0%' stop-color='%233a0007'/><stop offset='60%' stop-color='%23120003'/><stop offset='100%' stop-color='%23050001'/></radialGradient><linearGradient id='coreFire' x1='0' y1='100%' x2='0' y2='0%'><stop offset='0%' stop-color='%23d00000'/><stop offset='40%' stop-color='%23ff5500'/><stop offset='80%' stop-color='%23ffaa00'/><stop offset='100%' stop-color='%23ffffaa'/></linearGradient><radialGradient id='emberGlow' cx='50%' cy='50%' r='50%'><stop offset='0%' stop-color='%23ffaa00' stop-opacity='0.8'/><stop offset='100%' stop-color='%23ff0000' stop-opacity='0'/></radialGradient><filter id='fireGlow'><feGaussianBlur stdDeviation='5' result='blur'/><feMerge><feMergeNode in='blur'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><rect width='180' height='180' rx='40' fill='url(%23bg)'/><circle cx='90' cy='90' r='65' fill='url(%23emberGlow)'/><g filter='url(%23fireGlow)'><path d='M90 22 C65 22 45 42 45 67 C45 77 48 85 55 93 C48 88 43 78 48 68 C55 53 72 45 90 45 C108 45 125 53 132 68 C137 78 132 88 125 93 C132 85 135 77 135 67 C135 42 115 22 90 22 Z' fill='url(%23coreFire)' opacity='0.9'/><circle cx='90' cy='90' r='46' fill='none' stroke='url(%23coreFire)' stroke-width='18'/><circle cx='90' cy='90' r='37' fill='none' stroke='%23ffffcc' stroke-width='3' opacity='0.7'/><path d='M75 35 C80 25 85 15 90 10 C95 20 92 30 85 38 Z' fill='%23ffea00'/><path d='M105 38 C112 28 118 22 122 15 C122 25 116 32 110 42 Z' fill='%23ff5500'/><path d='M58 45 C50 35 45 28 40 22 C45 32 52 38 54 48 Z' fill='%23ff3300'/><circle cx='40' cy='110' r='3' fill='%23ffcc00'/><circle cx='140' cy='120' r='4' fill='%23ff5500'/><circle cx='130' cy='50' r='2.5' fill='%23ffffaa'/><circle cx='50' cy='60' r='3.5' fill='%23ffaa00'/></g></svg>">

  <style>
    body {
      margin: 0;
      padding: 0;
      background: #05020a;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow: hidden;
      font-family: 'Courier New', monospace;
    }
    canvas {
      border: 2px solid #00f6ff;
      box-shadow: 0 0 25px rgba(0, 246, 255, 0.4);
      touch-action: manipulation;
    }
  </style>
</head>
<body>

<canvas id="gameCanvas" width="360" height="640"></canvas>

<script>
  const canvas = document.getElementById("gameCanvas");
  const ctx = canvas.getContext("2d");

  // Load cinematic city background image
  const bgImage = new Image();
  bgImage.src = "https://images.unsplash.com/photo-1519501025264-65ba15a82390?q=80&w=1000&auto=format&fit=crop";

  const groundY = 530;
  let score = 0;
  let highScore = localStorage.getItem("oasis_highscore") || 0;
  let gameOver = false;
  let gameWon = false;
  let animFrame = 0;

  const player = {
    x: 50,
    y: groundY,
    width: 24,
    height: 48,
    vy: 0,
    gravity: 0.6,
    jumping: false
  };

  const obstacle = {
    x: 400,
    y: groundY + 20,
    width: 25,
    height: 28,
    speed: 4
  };

  const keyItem = {
    x: 600,
    y: groundY - 70,
    width: 20,
    height: 30,
    collected: false
  };

  function resetGame() {
    score = 0;
    gameOver = false;
    gameWon = false;
    player.y = groundY;
    player.vy = 0;
    player.jumping = false;
    obstacle.x = 400;
    keyItem.x = 600;
    keyItem.collected = false;
  }

  function update() {
    if (gameOver || gameWon) return;

    animFrame++;

    player.vy += player.gravity;
    player.y += player.vy;

    if (player.y >= groundY) {
      player.y = groundY;
      player.vy = 0;
      player.jumping = false;
    }

    obstacle.x -= obstacle.speed;
    if (obstacle.x < -30) {
      obstacle.x = 360 + Math.random() * 100;
      score += 10;
      if (score > highScore) {
        highScore = score;
        localStorage.setItem("oasis_highscore", highScore);
      }
    }

    if (!keyItem.collected) {
      keyItem.x -= 2;
      if (keyItem.x < -30) keyItem.x = 500;
    }

    // Collisions
    if (
      player.x < obstacle.x + obstacle.width &&
      player.x + player.width > obstacle.x &&
      player.y < obstacle.y + obstacle.height &&
      player.y + player.height > obstacle.y
    ) {
      gameOver = true;
    }

    if (
      !keyItem.collected &&
      player.x < keyItem.x + keyItem.width &&
      player.x + player.width > keyItem.x &&
      player.y < keyItem.y + keyItem.height &&
      player.y + player.height > keyItem.y
    ) {
      keyItem.collected = true;
      gameWon = true;
    }
  }

  // Draw Parzival character
  function drawPlayerCharacter(x, y, jumping, frame) {
    ctx.save();

    // 1. Hair
    ctx.fillStyle = '#4a2e17';
    ctx.fillRect(x + 5, y - 2, 14, 6);

    // 2. Head
    ctx.fillStyle = '#f1c27d';
    ctx.fillRect(x + 6, y + 4, 12, 10);

    // 3. VR Visor (Glowing Cyan)
    ctx.fillStyle = '#00f6ff';
    ctx.shadowBlur = 8;
    ctx.shadowColor = '#00f6ff';
    ctx.fillRect(x + 10, y + 6, 8, 4);
    ctx.shadowBlur = 0;

    // 4. Torso / Cyber Jacket
    ctx.fillStyle = '#1e1b4b';
    ctx.fillRect(x + 4, y + 14, 16, 18);

    // Neon Accent Line on Jacket
    ctx.fillStyle = '#ff3864';
    ctx.fillRect(x + 11, y + 14, 2, 18);

    // Arms
    ctx.fillStyle = '#1e1b4b';
    ctx.fillRect(x + 1, y + 16, 4, 12);
    ctx.fillRect(x + 19, y + 16, 4, 12);

    // Hands
    ctx.fillStyle = '#f1c27d';
    ctx.fillRect(x + 1, y + 27, 4, 4);
    ctx.fillRect(x + 19, y + 27, 4, 4);

    // 5. Legs / Boots (Animated Running or Bent Jumping)
    ctx.fillStyle = '#0f172a';
    if (jumping) {
      ctx.fillRect(x + 2, y + 32, 8, 8);
      ctx.fillRect(x + 14, y + 30, 8, 6);
      ctx.fillStyle = '#00f6ff';
      ctx.fillRect(x + 2, y + 38, 8, 4);
      ctx.fillRect(x + 14, y + 34, 8, 4);
    } else {
      let legOffset = Math.sin(frame * 0.3) * 5;
      ctx.fillRect(x + 5, y + 32, 5, 12 + legOffset);
      ctx.fillRect(x + 14, y + 32, 5, 12 - legOffset);
      ctx.fillStyle = '#00f6ff';
      ctx.fillRect(x + 5, y + 41 + legOffset, 5, 3);
      ctx.fillRect(x + 14, y + 41 - legOffset, 5, 3);
    }

    ctx.restore();
  }

  // Draw Copper Key
  function drawCopperKey(x, y) {
    ctx.save();
    ctx.fillStyle = '#e5c158';
    ctx.shadowBlur = 10;
    ctx.shadowColor = '#e5c158';

    // Key Ring Handle
    ctx.beginPath();
    ctx.arc(x + 8, y + 8, 7, 0, Math.PI * 2);
    ctx.fill();

    // Ring Hole
    ctx.fillStyle = '#05020a';
    ctx.beginPath();
    ctx.arc(x + 8, y + 8, 3, 0, Math.PI * 2);
    ctx.fill();

    // Key Stem
    ctx.fillStyle = '#e5c158';
    ctx.fillRect(x + 6, y + 14, 4, 16);

    // Key Teeth
    ctx.fillRect(x + 10, y + 22, 5, 3);
    ctx.fillRect(x + 10, y + 26, 6, 3);

    ctx.restore();
  }

  function draw() {
    // 1. Draw Background Image
    if (bgImage.complete) {
      ctx.drawImage(bgImage, 0, 0, canvas.width, canvas.height);
      ctx.fillStyle = 'rgba(10, 5, 25, 0.4)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    } else {
      ctx.fillStyle = '#0d0221';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    // 2. Neon Ground Line
    ctx.strokeStyle = '#ff3864';
    ctx.lineWidth = 3;
    ctx.shadowBlur = 10;
    ctx.shadowColor = '#ff3864';
    ctx.beginPath();
    ctx.moveTo(0, groundY + 48);
    ctx.lineTo(canvas.width, groundY + 48);
    ctx.stroke();
    ctx.shadowBlur = 0;

    // 3. Draw Character
    drawPlayerCharacter(player.x, player.y, player.jumping, animFrame);

    // 4. Sixer Obstacle
    ctx.fillStyle = '#ff3864';
    ctx.shadowBlur = 10;
    ctx.shadowColor = '#ff3864';
    ctx.fillRect(obstacle.x, obstacle.y, obstacle.width, obstacle.height);
    ctx.shadowBlur = 0;

    // 5. Copper Key
    if (!keyItem.collected) {
      drawCopperKey(keyItem.x, keyItem.y);
    }

    // 6. UI Text
    ctx.fillStyle = '#00f6ff';
    ctx.font = 'bold 14px monospace';
    ctx.fillText("SCORE: " + score, 15, 30);
    ctx.fillText("BEST: " + highScore, 15, 50);
    ctx.fillText("KEY: " + (keyItem.collected ? "FOUND!" : "SEARCHING..."), 200, 30);

    if (gameOver) {
      ctx.fillStyle = '#ff3864';
      ctx.font = 'bold 22px monospace';
      ctx.fillText("ZEROED OUT!", 110, 280);
      ctx.font = '13px monospace';
      ctx.fillText("Tap to Re-enter OASIS", 100, 310);
    }

    if (gameWon) {
      ctx.fillStyle = '#e5c158';
      ctx.font = 'bold 20px monospace';
      ctx.fillText("COPPER KEY ACQUIRED!", 60, 280);
      ctx.font = '13px monospace';
      ctx.fillText("Tap to Play Again", 110, 310);
    }
  }

  function gameLoop() {
    update();
    draw();
    requestAnimationFrame(gameLoop);
  }

  function handleInput() {
    if (gameOver || gameWon) {
      resetGame();
    } else if (!player.jumping) {
      player.vy = -12;
      player.jumping = true;
    }
  }

  window.addEventListener("touchstart", handleInput);
  window.addEventListener("mousedown", handleInput);

  gameLoop();
</script>

</body>
</html>
